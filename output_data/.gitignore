# Everything the pipeline computes stays out of git: the report and its
# figures show participants' brains, and the metrics are per-participant data.
report.html
figures/
metrics.csv

# Internal state: ignored, except the two small provenance records, which say
# what produced the outputs and from which inputs.
.skullstrip-bench/*
!.skullstrip-bench/PROVENANCE.json
!.skullstrip-bench/MANIFEST.json

# Guard: nothing should write NIfTI or pictures at this level, but keep this
# so a stray volume can never be committed by accident.
*.nii
*.nii.gz
*.png
*.jpg
