# Everything the pipeline computes stays out of git: masks and the report show
# participants' brains, and per-run metrics are per-participant data.
plan.json
derivatives/
runs/
logs/
work/
figures/
slurm/
*.png
*.jpg
*.csv
*.html

# Guard: no step writes NIfTI at this level, but keep this so a stray volume
# can never be committed by accident.
*.nii
*.nii.gz

# Provenance is a tracked output: it records what produced everything else.
!PROVENANCE.json
!MANIFEST.json
